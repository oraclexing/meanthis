{
  "manifest_version": 3,
  "name": "MeanThis",
  "version": "0.1.0",
  "key": "",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "description": "__MSG_extension_description__",
  "icons": {
    "16": "icons/meanthis-16.png",
    "32": "icons/meanthis-32.png",
    "48": "icons/meanthis-48.png",
    "128": "icons/meanthis-128.png"
  },
  "permissions": ["activeTab", "alarms", "contextMenus", "scripting", "sidePanel", "storage", "webNavigation"],
  "optional_host_permissions": ["http://127.0.0.1/*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_icon": {
      "16": "icons/meanthis-16.png",
      "32": "icons/meanthis-32.png",
      "48": "icons/meanthis-48.png",
      "128": "icons/meanthis-128.png"
    },
    "default_title": "__MSG_open_ui_attach__"
  }
}
